<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>log4jmigrate</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>step2-bridge</artifactId>
  <name>Step 2: log4j 1.x → 2.x ブリッジ (コード変更なし)</name>

  <dependencies>
    <!--
      log4j-1.2-api: log4j 1.x の API を log4j 2.x にブリッジするアダプタ。
      ソースコード変更なしで log4j 1.x の import のまま 2.x バックエンドで動く。
      移行の第一歩として最小リスクで適用できる。
    -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-1.2-api</artifactId>
    </dependency>

    <!-- log4j 2.x コア実装 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <!-- JsonTemplateLayout を使うために必要 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-layout-template-json</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <mainClass>com.example.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
