<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>log4jmigrate</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>step3-log4j2-native</artifactId>
  <name>Step 3: log4j 2.x ネイティブ API (完全移行)</name>

  <dependencies>
    <!-- log4j 2.x API (コンパイル依存) -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>

    <!-- log4j 2.x コア実装 (ランタイム依存で十分だが学習のため compile に) -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <!-- JsonTemplateLayout を使うために必要 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-layout-template-json</artifactId>
    </dependency>

    <!-- 非同期ロギング用 (LMAX Disruptor) — 高スループット環境向け -->
    <dependency>
      <groupId>com.lmax</groupId>
      <artifactId>disruptor</artifactId>
      <version>4.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <mainClass>com.example.App</mainClass>
          <!-- 非同期ロガー有効化 -->
          <systemProperties>
            <systemProperty>
              <key>log4j2.contextSelector</key>
              <value>org.apache.logging.log4j.core.async.AsyncLoggerContextSelector</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
