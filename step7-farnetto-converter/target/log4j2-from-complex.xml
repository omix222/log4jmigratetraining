<?xml version="1.0" encoding="UTF-8"?>
<!--
  log4j 1.x の設定ファイル (XML 形式) — 変換ツールの入力サンプル。
  properties 形式と同じ設定を XML で記述したもの。

  注意: log4j 1.x の XML は <!DOCTYPE> が必要。
        log4j 2.x の XML (log4j2.xml) とは全く別物。
-->
<Configuration status="warn">

    <Appenders>
    
          <!-- ConsoleAppender -->
        <Console name="Console">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5p %c{1} [%X{orderId}] - %m%n"/>
            <Filter type="ThresholdFilter" level="DEBUG"/>
        </Console>
        
          <!-- RollingFileAppender -->
        <RollingFile name="RollingFile" fileName="target/rolling.log" filePattern="target/rolling-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5p %c{2} - %m%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>    
        </RollingFile>
        
          <!-- DailyRollingFileAppender -->
        <DailyRollingFileAppender name="DailyFile">
            <Param name="File" value="target/daily.log"/>
            <Param name="DatePattern" value="'.'yyyy-MM-dd"/>
        </DailyRollingFileAppender>
        
    </Appenders>
    
    <Loggers>
          <!-- ロガー: com.example — DEBUG レベル、additivity=false -->
        <Logger name="com.example" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        
          <!-- ロガー: com.example.database — WARN のみ -->
        <Logger name="com.example.database" level="WARN" additivity="false">
            <AppenderRef ref="DailyFile"/>
        </Logger>
        
          <!-- 外部ライブラリの抑制 -->
        <Logger name="org.springframework" level="WARN"/>
        
          <!-- ルートロガー -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>      
    
    </Loggers>
    
</Configuration>
