<?xml version="1.0" ?><Configuration name="Log4j1"><Appenders><File name="AppFile" fileName="target/app.log" append="true"><PatternLayout pattern="%d{ISO8601} [%t] %-5v1Level %c - %m%n"/></File><RollingFile name="DailyFile" fileName="target/daily.log" filePattern="target/daily.log%d{'.'yyyy-MM-dd}"><PatternLayout pattern="%d %-5v1Level [%t] %c{2} - %m%n"/><Policies><TimeBasedTriggeringPolicy modulate="true"/></Policies><DefaultRolloverStrategy max="2147483647" fileIndex="min"/></RollingFile><RollingFile name="RollingFile" fileName="target/rolling.log" filePattern="target/rolling.log.%i"><PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5v1Level %c{2} - %m%n"/><Policies><SizeBasedTriggeringPolicy size="10MB"/></Policies><DefaultRolloverStrategy max="5" fileIndex="min"/></RollingFile><Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5v1Level %c{1} [%properties{orderId}] - %m%n"/></Console></Appenders><Loggers><Root level="INFO"><AppenderRef ref="Console"/><AppenderRef ref="RollingFile"/></Root><Logger name="org.springframework" level="WARN"/><Logger name="org.hibernate" level="ERROR"/><Logger name="com.example.database" level="WARN"><AppenderRef ref="DailyFile"/></Logger><Logger name="com.example" level="DEBUG"><AppenderRef ref="Console"/><AppenderRef ref="RollingFile"/></Logger></Loggers></Configuration>