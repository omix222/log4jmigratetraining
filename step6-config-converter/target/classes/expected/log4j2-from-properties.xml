<?xml version="1.0" ?>
<!--
  Log4j1ConfigurationConverter の実際の出力 (整形済み)。

  実行コマンド:
    mvn -pl step6-config-converter exec:java@convert-properties
  出力先:
    step6-config-converter/target/log4j2-from-properties.xml

  変換された内容の注意点:
    1. %-5p (log4j 1.x) → %-5v1Level に変換される
       → log4j2.xml では %-5level が正しい記法。手動修正が必要。

    2. %X{orderId} (MDC) → %properties{orderId} に変換される
       → log4j2.xml では %X{orderId} が正しい記法。手動修正が必要。

    3. DailyRollingFileAppender が RollingFile + TimeBasedTriggeringPolicy に変換される
       → filePattern が自動生成されているが、適切に確認すること。

    4. additivity=false が Logger に適用されていないことがある
       → 生成後に必ず確認し、手動で additivity="false" を追加すること。

    5. Threshold (アペンダーレベルフィルタ) → ThresholdFilter に変換されない場合がある
       → 必要に応じて手動で追加すること。
-->
<Configuration name="Log4j1">
  <Appenders>
    <File name="AppFile" fileName="target/app.log" append="true">
      <!-- 注意: %-5v1Level は誤り → %-5level に修正すること -->
      <PatternLayout pattern="%d{ISO8601} [%t] %-5v1Level %c - %m%n"/>
    </File>
    <RollingFile name="DailyFile" fileName="target/daily.log"
                 filePattern="target/daily.log%d{'.'yyyy-MM-dd}">
      <PatternLayout pattern="%d %-5v1Level [%t] %c{2} - %m%n"/>
      <Policies>
        <TimeBasedTriggeringPolicy modulate="true"/>
      </Policies>
      <DefaultRolloverStrategy max="2147483647" fileIndex="min"/>
    </RollingFile>
    <RollingFile name="RollingFile" fileName="target/rolling.log"
                 filePattern="target/rolling.log.%i">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5v1Level %c{2} - %m%n"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="10MB"/>
      </Policies>
      <DefaultRolloverStrategy max="5" fileIndex="min"/>
    </RollingFile>
    <Console name="Console" target="SYSTEM_OUT">
      <!-- 注意: %properties{orderId} は誤り → %X{orderId} に修正すること -->
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5v1Level %c{1} [%properties{orderId}] - %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="RollingFile"/>
    </Root>
    <Logger name="org.springframework" level="WARN"/>
    <Logger name="org.hibernate" level="ERROR"/>
    <!-- 注意: additivity=false が失われている → additivity="false" を手動追加すること -->
    <Logger name="com.example.database" level="WARN">
      <AppenderRef ref="DailyFile"/>
    </Logger>
    <Logger name="com.example" level="DEBUG">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="RollingFile"/>
    </Logger>
  </Loggers>
</Configuration>
